class_name MaterialLibrary
extends RefCounted
## Central factory for every procedural material in the game. Materials are cached so the
## whole city shares a small number of shaders/materials (per-object variation comes from
## instance uniforms). No image files are used: surface detail is generated by shaders and
## by runtime NoiseTexture2D resources.

const FACADE_SHADER: String = "res://shaders/facade.gdshader"
const ASPHALT_SHADER: String = "res://shaders/asphalt.gdshader"
const PAVEMENT_SHADER: String = "res://shaders/pavement.gdshader"
const CONCRETE_SHADER: String = "res://shaders/concrete.gdshader"
const METAL_SHADER: String = "res://shaders/metal_panel.gdshader"
const FOLIAGE_SHADER: String = "res://shaders/foliage.gdshader"
const ROAD_PAINT_SHADER: String = "res://shaders/road_paint.gdshader"

static var _cache: Dictionary = {}
static var _noise_normals: Dictionary = {}


static func facade() -> ShaderMaterial:
	return _shader_material(FACADE_SHADER)


static func asphalt() -> ShaderMaterial:
	return _shader_material(ASPHALT_SHADER)


static func pavement() -> ShaderMaterial:
	return _shader_material(PAVEMENT_SHADER)


static func concrete() -> ShaderMaterial:
	return _shader_material(CONCRETE_SHADER)


static func metal_panel() -> ShaderMaterial:
	return _shader_material(METAL_SHADER)


static func foliage() -> ShaderMaterial:
	return _shader_material(FOLIAGE_SHADER)


static func road_paint() -> ShaderMaterial:
	return _shader_material(ROAD_PAINT_SHADER)


## Generic PBR surface with a procedural micro-normal map for texture.
static func surface(color: Color, roughness: float = 0.8, metallic: float = 0.0, detail: float = 1.0, detail_scale: float = 3.0) -> StandardMaterial3D:
	var key: String = "surface|%s|%.2f|%.2f|%.2f|%.2f" % [color.to_html(), roughness, metallic, detail, detail_scale]
	if _cache.has(key):
		return _cache[key]
	var material := StandardMaterial3D.new()
	material.albedo_color = color
	material.roughness = roughness
	material.metallic = metallic
	if detail > 0.0:
		material.normal_enabled = true
		material.normal_texture = _noise_normal(0.09, detail * 6.0)
		material.normal_scale = detail
		material.uv1_triplanar = true
		material.uv1_world_triplanar = false
		material.uv1_scale = Vector3.ONE * detail_scale
	_cache[key] = material
	return material


## Woven fabric (clothing): fine high-frequency normal noise, soft sheen.
static func fabric(color: Color) -> StandardMaterial3D:
	var key: String = "fabric|%s" % color.to_html()
	if _cache.has(key):
		return _cache[key]
	var material := StandardMaterial3D.new()
	material.albedo_color = color
	material.roughness = 0.92
	material.normal_enabled = true
	material.normal_texture = _noise_normal(0.35, 3.0)
	material.normal_scale = 0.6
	material.uv1_triplanar = true
	material.uv1_scale = Vector3.ONE * 6.0
	material.rim_enabled = true
	material.rim = 0.25
	material.rim_tint = 0.6
	_cache[key] = material
	return material


## Hard armour / car paint: metallic flake with clear-coat.
static func coated(color: Color, metallic: float = 0.55, roughness: float = 0.35) -> StandardMaterial3D:
	var key: String = "coated|%s|%.2f|%.2f" % [color.to_html(), metallic, roughness]
	if _cache.has(key):
		return _cache[key]
	var material := StandardMaterial3D.new()
	material.albedo_color = color
	material.metallic = metallic
	material.roughness = roughness
	material.clearcoat_enabled = true
	material.clearcoat = 0.8
	material.clearcoat_roughness = 0.15
	_cache[key] = material
	return material


static func glass(tint: Color = Color(0.05, 0.07, 0.09)) -> StandardMaterial3D:
	var key: String = "glass|%s" % tint.to_html()
	if _cache.has(key):
		return _cache[key]
	var material := StandardMaterial3D.new()
	material.albedo_color = tint
	material.metallic = 0.7
	material.roughness = 0.04
	material.clearcoat_enabled = true
	_cache[key] = material
	return material


static func skin(color: Color = Color(0.72, 0.53, 0.42)) -> StandardMaterial3D:
	var key: String = "skin|%s" % color.to_html()
	if _cache.has(key):
		return _cache[key]
	var material := StandardMaterial3D.new()
	material.albedo_color = color
	material.roughness = 0.6
	material.subsurf_scatter_enabled = true
	material.subsurf_scatter_strength = 0.4
	_cache[key] = material
	return material


## Light-emitting surface. `cached` = false returns a unique instance that can be animated.
static func emissive(color: Color, energy: float = 2.0, cached: bool = true) -> StandardMaterial3D:
	var key: String = "emissive|%s|%.2f" % [color.to_html(), energy]
	if cached and _cache.has(key):
		return _cache[key]
	var material := StandardMaterial3D.new()
	material.albedo_color = color
	material.emission_enabled = true
	material.emission = color
	material.emission_energy_multiplier = energy
	material.roughness = 0.4
	if cached:
		_cache[key] = material
	return material


static func hologram(color: Color, alpha: float = 0.35) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	material.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
	material.cull_mode = BaseMaterial3D.CULL_DISABLED
	material.albedo_color = Color(color, alpha)
	return material


static func _shader_material(path: String) -> ShaderMaterial:
	if _cache.has(path):
		return _cache[path]
	var material := ShaderMaterial.new()
	material.shader = load(path) as Shader
	_cache[path] = material
	return material


static func _noise_normal(frequency: float, bump: float) -> NoiseTexture2D:
	var key: String = "%.3f|%.2f" % [frequency, bump]
	if _noise_normals.has(key):
		return _noise_normals[key]
	var noise := FastNoiseLite.new()
	noise.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	noise.frequency = frequency
	noise.fractal_octaves = 4
	var texture := NoiseTexture2D.new()
	texture.width = 256
	texture.height = 256
	texture.seamless = true
	texture.as_normal_map = true
	texture.bump_strength = bump
	texture.noise = noise
	_noise_normals[key] = texture
	return texture
